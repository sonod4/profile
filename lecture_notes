            return `
                <div class="p-4 rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
                    <!-- Course Title -->
                    <h3 class="font-semibold text-slate-900 dark:text-slate-100 text-base">${course.title}</h3>
                    
                    ${course.note ? `<p class="text-xs text-slate-600 dark:text-slate-400 mt-1 mb-3 leading-relaxed">${course.note}</p>` : '<div class="mb-3"></div>'}

                    <!-- File List with Star Ratings -->
                    <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 space-y-1.5">
                        ${course.files.map(file => `
                            <div class="flex items-center justify-between text-xs py-1 group">
                                <div class="flex items-center gap-2 truncate pr-2">
                                    <!-- Star Rating -->
                                    <span class="${file.rating === 4 ? 'star-rating-4' : 'star-rating'} text-[11px] font-mono flex-shrink-0" title="${file.rating || 3} out of 3 stars">
                                        ${renderStars(file.rating)}
                                    </span>

                                    <!-- Format Badge -->
                                    <span class="font-mono text-[10px] px-1.5 py-0.5 rounded border ${badgeStyles[file.type] || badgeStyles.PDF}">
                                        ${file.type}
                                    </span>


                                    <!-- Author Badge (NEW) -->
                                    ${file.author ? `
                                        <span class="font-mono text-[10px] px-1.5 py-0.5 rounded border ${authorBadgeStyles[file.author] || authorBadgeStyles.Default}">
                                            ${file.author}
                                        </span>
                                    ` : ''}

                                    <!-- File Title Link -->
                                    <a href="${file.url}" target="_blank" class="font-mono text-slate-700 dark:text-slate-300 hover:text-black dark:hover:text-white underline truncate">
                                        ${file.name}
                                    </a>

                                    ${file.comment ? `
                                        <span class="font-mono text-[11px] text-slate-500 dark:text-slate-400 italic">
                                            ${file.comment}
                                        </span>
                                    ` : ''}
                                </div>
                                
                                <div class="flex items-center gap-3 text-slate-400 dark:text-slate-500 font-mono text-[11px] flex-shrink-0">
                                    <span>${file.size}</span>
                                    <a href="${file.url}" download class="text-slate-600 dark:text-slate-400 hover:text-black dark:hover:text-white hover:underline">
                                        Download ↓
                                    </a>
                                </div>
                            </div>
                        `).join("")}
                    </div>
                </div>
            `;
        }
    </script>
</body>
</html>