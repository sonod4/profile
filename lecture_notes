        let searchQuery = "";
        let currentSort = "alpha-asc";

        // Helper to output star string (max 5)
        function renderStars(rating = 3) {
            if(rating==4) rating==3;
            const count = Math.min(Math.max(Number(rating) || 0, 1), 3);
            return '★'.repeat(count) + '☆'.repeat(3 - count);
        }

        // Get max star rating of a course
        function getCourseMaxRating(course) {
            if (!course.files || course.files.length === 0) return 0;
            return Math.max(...course.files.map(f => f.rating || 0));
        }

        // Initialize Archive on Load
        document.addEventListener("DOMContentLoaded", () => {
            renderArchive();
        });

        // Search Input Handler
        function handleSearch() {
            searchQuery = document.getElementById("searchInput").value.toLowerCase().trim();
            const resetBtn = document.getElementById("resetBtn");
            
            if (searchQuery) {
                resetBtn.classList.remove("hidden");
            } else {
                resetBtn.classList.add("hidden");
            }

            renderArchive();
        }

        // Sort Handler
        function handleSort() {
            currentSort = document.getElementById("sortSelect").value;
            renderArchive();
        }

        // Clear Search
        function resetSearch() {
            searchQuery = "";
            document.getElementById("searchInput").value = "";
            document.getElementById("resetBtn").classList.add("hidden");
            renderArchive();
        }

        // Render function
        function renderArchive() {
            const container = document.getElementById("courseArchive");
            const noResults = document.getElementById("noResults");
            const resultsCount = document.getElementById("resultsCount");

            // 1. Filter courses
            let filteredCourses = coursesData.filter(course => {
                if (!searchQuery) return true;
                
                const matchesTitle = course.title.toLowerCase().includes(searchQuery);
                const matchesNote = course.note ? course.note.toLowerCase().includes(searchQuery) : false;
                // const matchesFiles = course.files.some(f => f.name.toLowerCase().includes(searchQuery));
                const matchesFiles = course.files.some(f => 
                                                            f.name.toLowerCase().includes(searchQuery) || 
                                                            (f.author && f.author.toLowerCase().includes(searchQuery)) ||
                                                            (f.comment && f.comment.toLowerCase().includes(searchQuery)) ||
                                                            (f.type && f.type.toLowerCase().includes(searchQuery))
                                                        );

                return matchesTitle || matchesNote || matchesFiles;
            });

            // 2. Sort courses
            filteredCourses.sort((a, b) => {
                if (currentSort === "alpha-asc" || currentSort === "default") {
                    return a.title.localeCompare(b.title);
                } else if (currentSort === "alpha-desc") {
                    return b.title.localeCompare(a.title);
                } else if (currentSort === "stars-desc") {
                    const ratingDiff = getCourseMaxRating(b) - getCourseMaxRating(a);
                    return ratingDiff !== 0 ? ratingDiff : a.title.localeCompare(b.title);
                } else if (currentSort === "stars-asc") {
                    const ratingDiff = getCourseMaxRating(a) - getCourseMaxRating(b);
                    return ratingDiff !== 0 ? ratingDiff : a.title.localeCompare(b.title);
                }
                return 0; // default order
            });

            // 3. Render
            if (filteredCourses.length === 0) {
                container.innerHTML = "";
                noResults.classList.remove("hidden");
                resultsCount.textContent = "0 courses found";
            } else {
                noResults.classList.add("hidden");
                container.innerHTML = filteredCourses.map(course => renderCourseCard(course)).join("");
                resultsCount.textContent = `Showing ${filteredCourses.length} course${filteredCourses.length > 1 ? 's' : ''}`;
            }
        }

        // Single Course Card Template
